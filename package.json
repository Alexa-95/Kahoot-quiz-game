{
  "name": "quiz-live",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lokalny quiz na żywo dla wielu graczy",
  "scripts": {
    "dev": "nodemon --watch server.js --watch src --watch scripts --watch client --watch vite.config.js --ext js,jsx,html,css,json scripts/dev-server.js",
    "build": "vite build",
    "prestart": "npm run build",
    "start": "node server.js",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/qrcode": "^1.5.5",
    "nodemon": "^3.1.14",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
